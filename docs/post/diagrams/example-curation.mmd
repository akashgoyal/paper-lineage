flowchart LR
  Q(["Visitor question<br/>answered 'partial'"]):::person -- "/api/ask" --> GAP[("Sanity Content Lake<br/>gap document")]:::sanity
  GAP --> INBOX["Lineage Desk · Inbox<br/>(Sanity App SDK)"]:::onsanity
  INBOX --> REVIEW["Lineage Desk · Review<br/>evidence + relation"]:::onsanity
  REVIEW -- "Accept: decision + publish,<br/>one transaction" --> LINK[("Sanity Content Lake<br/>link: accepted")]:::sanity
  LINK --> LIVE["Sanity Live Content API"]:::sanity
  LIVE --> SITE["Site: relation label appears,<br/>graph line turns solid"]:::ours
  LINK --> ASK["Agent may now use<br/>the relation word"]:::ours
  LEG["Red = Sanity feature · peach = our app on Sanity · blue = our code · grey = third party"]:::legend
