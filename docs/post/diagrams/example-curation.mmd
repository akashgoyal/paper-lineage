flowchart LR
  Q["Visitor question<br/>answered 'partial'"]:::person -- "/api/ask" --> GAP[("gap<br/>'BLIP-2 links unreviewed'")]:::sanity
  GAP --> INBOX["Desk · Inbox<br/>most-asked gaps first"]:::onsanity
  INBOX --> REVIEW["Desk · Review<br/>evidence sentence + relation"]:::onsanity
  REVIEW -- "Accept: decision + publish<br/>in one transaction" --> LINK[("link<br/>reviewDecision = accepted")]:::sanity
  LINK -- "Live Content API" --> SITE["Site: relation label appears,<br/>graph line turns solid"]:::ours
  LINK --> ASK["Next answer may use<br/>the relation word"]:::ours

  classDef sanity fill:#FDE3E0,stroke:#E0402F,color:#3B0D08,stroke-width:1.5px
  classDef onsanity fill:#FFF0D2,stroke:#B45309,color:#3D2302,stroke-width:1.5px
  classDef ours fill:#E3EAFE,stroke:#3446C4,color:#121A4A,stroke-width:1.5px
  classDef third fill:#F4F4F5,stroke:#6B7280,color:#1F2937,stroke-dasharray:4 3
  classDef person fill:#FFFFFF,stroke:#17191E,color:#17191E
