flowchart TB
  CALL["Model calls a display tool with ids<br/>showChain · showQuote · showPapers"]:::third
  CALL --> C1["1 · every id exists in Sanity Content Lake"]:::ours
  C1 --> C2["2 · chain: papers in date order, a link at every hop"]:::ours
  C2 --> C3["3 · quote verbatim in Sanity Knowledge Base entry<br/>or stored citation sentence"]:::ours
  C3 --> C4["4 · within the card budget"]:::ours
  C4 --> CARD["Card rebuilt from the Sanity documents<br/>relation shown only if the link is accepted"]:::ours
  S[("Sanity Content Lake<br/>+ Sanity Knowledge Base")]:::sanity == "every check reads<br/>Sanity by id" ==> C1
  C1 & C2 & C3 & C4 -. "fails" .-> ERR["Error returned to the model<br/>e.g. 'No link from BLIP to Flamingo'"]:::warn
  ERR -. "model corrects the call" .-> CALL
  LEG["Red = Sanity feature · peach = our app on Sanity · blue = our code · grey = third party"]:::legend
  classDef sanity fill:#E8412E,stroke:#9F2414,color:#FFFFFF,stroke-width:2px,font-weight:bold
  classDef onsanity fill:#FDE3D0,stroke:#E8412E,color:#3D1408,stroke-width:2px
  classDef ours fill:#EEF2FB,stroke:#8A9AC9,color:#1E2A4A,stroke-width:1px
  classDef third fill:#F6F6F7,stroke:#A1A1AA,color:#3F3F46,stroke-dasharray:4 3
  classDef person fill:#FFFFFF,stroke:#17191E,color:#17191E
  classDef warn fill:#FEF3C7,stroke:#A16207,color:#422006,stroke-dasharray:4 3
  classDef legend fill:#FFFFFF,stroke:#D4D4D8,color:#3F3F46,font-size:12px
